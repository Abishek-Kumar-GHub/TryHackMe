s = o.ExpandEnvironmentStrings(Chr(37)&Chr(83)&Chr(89)&Chr(83)&Chr(84)&Chr(69)&Chr(77)&Chr(82)&Chr(79)&Chr(79)&Chr(84)&Chr(37))
